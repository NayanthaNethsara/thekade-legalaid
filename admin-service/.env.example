# Postgres (must have the pgvector extension; image pgvector/pgvector:pg16)
DATABASE_URL=postgresql://legalaid:legalaid@localhost:5433/legalaid

# Optional: separate URL used by Alembic only. Falls back to DATABASE_URL.
DIRECT_URL=

# File storage
DATA_DIR=data
MARKDOWN_DIR=data/markdown

# Google Gemini (embeddings: gemini-embedding-001 @ 768 dims)
GEMINI_API_KEY=your-key-here
EMBED_MODEL=models/gemini-embedding-001
EMBED_DIM=768

# Chunking
CHUNK_MAX_CHARS=2000
CHUNK_OVERLAP=200
