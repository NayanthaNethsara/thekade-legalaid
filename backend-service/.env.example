# Service
ENVIRONMENT=development
LOG_LEVEL=INFO
HTTP_PORT=8000

# NATS JetStream (must match the whatsapp-gateway contract)
NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=KAKILLE_AGENT_EVENTS
NATS_DURABLE_NAME=backend-service
NATS_SUBJECT_INCOMING_TEXT=whatsapp.incoming.text
NATS_SUBJECT_INCOMING_IMAGE=whatsapp.incoming.media.image
NATS_SUBJECT_INCOMING_VIDEO=whatsapp.incoming.media.video
NATS_SUBJECT_INCOMING_AUDIO=whatsapp.incoming.media.audio
NATS_SUBJECT_INCOMING_DOCUMENT=whatsapp.incoming.media.document
NATS_SUBJECT_OUTGOING=whatsapp.outgoing

# Database (async Postgres; host port 5433 from docker-compose)
DATABASE_URL=postgresql+asyncpg://kakille_agent:kakille_agent@localhost:5433/kakille_agent

# Redis (ephemeral guest sessions + rate-limit windows; host port 6379)
REDIS_URL=redis://localhost:6379/0

# Rate limiting (Redis-backed sliding windows). Defaults shown; set
# RATE_LIMIT_ENABLED=false to disable all checks in dev/tests.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_LIMIT=5
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_CHAT_LIMIT=30
RATE_LIMIT_CHAT_WINDOW_SECONDS=60
RATE_LIMIT_GUEST_CREATE_LIMIT=10
RATE_LIMIT_GUEST_CREATE_WINDOW_SECONDS=3600
RATE_LIMIT_GLOBAL_LIMIT=120
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60

# Shared secret proving requests come from our own frontend. Required on every
# business route (auth, guest, chat, profile); only health/metrics are open.
INTERNAL_API_KEY=dev-internal-key-change-me

# Auth
AUTH_JWT_SECRET=dev-secret-change-me
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TTL_MINUTES=15
AUTH_REFRESH_TTL_DAYS=30
AUTH_DEFAULT_COUNTRY_CODE=94
AUTH_GUEST_TTL_SECONDS=86400

# Firebase project that issues the web app's Google sign-in ID tokens; the
# backend verifies every token against this project (required in production).
FIREBASE_PROJECT_ID=

# LLM (pluggable provider). Leave the active provider's credentials blank to
# boot without AI -- the orchestrator returns a graceful fallback reply.
# LLM_PROVIDER: "vertexai" (Vertex AI via ADC) or "gemini" (Developer API key)
LLM_PROVIDER=vertexai
LLM_MODEL=gemini-2.5-flash
# Optional model for final customer-facing responses. Falls back to LLM_MODEL if blank.
LLM_GENERATION_MODEL=
LLM_TEMPERATURE=0.7

# Vertex AI (LLM_PROVIDER=vertexai): authenticates via Application Default
# Credentials -- run `gcloud auth application-default login`.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Gemini Developer API (LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# Image search / KakilleVision. POST /chat/image-search identifies an uploaded image
# with the same multimodal Gemini model and returns a search query; the client
# then sends it as a normal text turn. The image is never stored.
# VISION_ENABLED=false disables the endpoint; VISION_MAX_IMAGE_BYTES caps size.
VISION_ENABLED=true
VISION_MAX_IMAGE_BYTES=8388608

# Kakille MCP tool server (leave MCP_URL blank to run text-only without tools)
MCP_URL=https://mcp.kakille.ai/mcp
MCP_API_KEY=

# Model Armor guardrail (leave MODEL_ARMOR_TEMPLATE blank to disable). Create a
# template -- default settings are fine -- in your GCP project; it uses the same
# Vertex credentials. Model Armor is regional, so "global" is not supported, and
# MODEL_ARMOR_LOCATION must match the template's region. MODEL_ARMOR_TEMPLATE
# accepts a bare id (wrapped with project+location) or a full resource path.
MODEL_ARMOR_LOCATION=us-central1
MODEL_ARMOR_TEMPLATE=
