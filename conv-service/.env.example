DATABASE_URL=postgresql://user:password@localhost:5432/legalaid
DIRECT_URL=postgresql://user:password@localhost:5432/legalaid

# NATS JetStream Configuration
NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=LEGALAID_EVENTS

# NATS Subjects
NATS_SUBJECT_INCOMING_TEXT=whatsapp.incoming.text
NATS_SUBJECT_INCOMING_VOICE=whatsapp.incoming.voice
NATS_SUBJECT_INCOMING_DOCUMENT=whatsapp.incoming.document
NATS_SUBJECT_INCOMING_FILE=whatsapp.incoming.files
NATS_SUBJECT_OUTGOING_TEXT=whatsapp.outgoing.text
NATS_SUBJECT_OUTGOING_MEDIA=whatsapp.outgoing.media
NATS_SUBJECT_INCOMING=whatsapp.incoming.messages
NATS_SUBJECT_OUTGOING=whatsapp.outgoing.messages
NATS_SUBJECT_INDEXING_TRUSTED=indexing.trusted_files
NATS_SUBJECT_RAG_QUERIES=rag.queries


# RAG & Vector Search Configuration

# OpenAI API Key (get from https://platform.openai.com)
OPENAI_API_KEY=sk-proj-...

# Embedding model and dimension
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DIM=1536

# Chunking parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval parameters
RAG_TOP_K=5

# ==============================================
# Redis Configuration (Optional but Recommended)
# ==============================================
# For caching embeddings and chat history
REDIS_URL=redis://localhost:6379

# For Redis with auth:
# REDIS_URL=redis://:password@localhost:6379

# ==============================================
# Azure Storage Configuration
# ==============================================
# Connection string for Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net
