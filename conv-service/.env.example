DATABASE_URL=postgresql://user:password@localhost:5432/legalaid
DIRECT_URL=postgresql://user:password@localhost:5432/legalaid

# Kafka Configuration
KAFKA_BROKER_URL=localhost:9092

# Kafka Topics
KAFKA_TOPIC_INCOMING=whatsapp.incoming.messages
KAFKA_TOPIC_INCOMING_FILE=whatsapp.incoming.files
KAFKA_TOPIC_OUTGOING=whatsapp.outgoing.messages
KAFKA_TOPIC_INDEXING_TRUSTED=indexing.trusted_files
KAFKA_TOPIC_RAG_QUERIES=rag.queries

# Kafka Authentication (leave empty for local/no auth)
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=PLAIN

# For Confluent Cloud or secured Kafka:
# KAFKA_BROKER_URL=pkc-xxxxx.region.provider.confluent.cloud:9092
# KAFKA_USERNAME=your_api_key
# KAFKA_PASSWORD=your_api_secret
# KAFKA_SSL=true
# KAFKA_SASL_MECHANISM=PLAIN


# RAG & Vector Search Configuration

# OpenAI API Key (get from https://platform.openai.com)
OPENAI_API_KEY=sk-proj-...

# Embedding model and dimension
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DIM=1536

# Chunking parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval parameters
RAG_TOP_K=5

# ==============================================
# Redis Configuration (Optional but Recommended)
# ==============================================
# For caching embeddings and chat history
REDIS_URL=redis://localhost:6379

# For Redis with auth:
# REDIS_URL=redis://:password@localhost:6379

# ==============================================
# Azure Storage Configuration
# ==============================================
# Connection string for Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net
