# ==============================================
# LOCAL Development Database (RAG)
# ==============================================
DATABASE_URL=postgresql://postgres:localpassword@localhost:5433/legalaid_rag_dev
DIRECT_URL=postgresql://postgres:localpassword@localhost:5433/legalaid_rag_dev

# ==============================================
# Kafka Configuration (use local for dev)
# ==============================================
KAFKA_BROKER_URL=localhost:9092

# Kafka Topics
KAFKA_TOPIC_INCOMING=whatsapp.incoming.messages
KAFKA_TOPIC_INCOMING_FILE=whatsapp.incoming.files
KAFKA_TOPIC_OUTGOING=whatsapp.outgoing.messages
KAFKA_TOPIC_INDEXING_TRUSTED=indexing.trusted_files
KAFKA_TOPIC_RAG_QUERIES=rag.queries

# Kafka Authentication (leave empty for local)
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=PLAIN

# ==============================================
# RAG & Vector Search Configuration
# ==============================================
# OpenAI API Key (get from https://platform.openai.com)
OPENAI_API_KEY=sk-proj-...

# Embedding model and dimension
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DIM=1536

# Chunking parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval parameters
RAG_TOP_K=5

# ==============================================
# Redis Configuration (Optional - use local)
# ==============================================
REDIS_URL=redis://localhost:6379

# ==============================================
# Azure Storage Configuration (dev/test)
# ==============================================
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net
