# ==============================================
# LOCAL Development Database (RAG)
# ==============================================
DATABASE_URL=postgresql://postgres:localpassword@localhost:5433/legalaid_rag_dev
DIRECT_URL=postgresql://postgres:localpassword@localhost:5433/legalaid_rag_dev

# ==============================================
# NATS JetStream Configuration (use local for dev)
# ==============================================
NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=LEGALAID_EVENTS

# NATS Subjects
NATS_SUBJECT_INCOMING=whatsapp.incoming.messages
NATS_SUBJECT_INCOMING_FILE=whatsapp.incoming.files
NATS_SUBJECT_OUTGOING=whatsapp.outgoing.messages
NATS_SUBJECT_INDEXING_TRUSTED=indexing.trusted_files
NATS_SUBJECT_RAG_QUERIES=rag.queries

# ==============================================
# RAG & Vector Search Configuration
# ==============================================
# OpenAI API Key (get from https://platform.openai.com)
OPENAI_API_KEY=sk-proj-...

# Embedding model and dimension
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DIM=1536

# Chunking parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval parameters
RAG_TOP_K=5

# ==============================================
# Redis Configuration (Optional - use local)
# ==============================================
REDIS_URL=redis://localhost:6379

# ==============================================
# Azure Storage Configuration (dev/test)
# ==============================================
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net
