# core-service configuration (for local `go run`; compose sets these directly)
ENV=development
PORT=8002
NATS_URL=nats://localhost:4222

# Shared Postgres (host port 5433 -> container 5432).
DATABASE_URL=postgres://legalaid:legalaid@localhost:5433/legalaid

# NATS subjects shared with the whatsapp-gateway.
NATS_SUBJECT_INCOMING_TEXT=whatsapp.incoming.text
NATS_SUBJECT_OUTGOING_TEXT=whatsapp.outgoing.text

# Shared secret for verifying HMAC-signed requests from the Next.js edge.
# MUST match the frontend and admin-service. Generate with: openssl rand -hex 32
INTERNAL_AUTH_SECRET=

# Redis backing the request-nonce replay store.
REDIS_URL=redis://localhost:6379
