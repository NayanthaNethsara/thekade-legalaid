# Backend auth API base URL (server-side only; never exposed to the browser)
BACKEND_API_URL=http://localhost:8000

# Shared secret sent on every backend call; the backend rejects requests
# without it. Must match the backend's INTERNAL_API_KEY. Server-side only;
# never exposed to the browser.
INTERNAL_API_KEY=dev-internal-key-change-me

# NextAuth (Auth.js) session encryption secret.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Firebase web app config for Google sign-in (Firebase console -> Project
# settings -> Your apps). Public by design; the backend independently verifies
# every ID token against the same project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Arcjet edge protection (bot detection, shield, per-IP throttle). Get a key at
# https://app.arcjet.com. Leave blank to disable Arcjet in dev/CI; the backend's
# Redis rate limits remain the authoritative protection.
ARCJET_KEY=

# Tells Arcjet this is local dev so private/localhost IPs are not flagged as
# spoofed. Remove (or set to "production") when deploying.
ARCJET_ENV=development
