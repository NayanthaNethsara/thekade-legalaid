# Meta Business API Configuration
META_VERIFY_TOKEN=your_secure_verify_token_here
META_APP_SECRET=your_meta_app_secret_here

# WhatsApp Cloud API Configuration
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_ACCESS_TOKEN=your_access_token

PORT=3000

# NATS JetStream Configuration
NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=LEGALAID_EVENTS
NATS_SUBJECT_INCOMING_TEXT=whatsapp.incoming.text
NATS_SUBJECT_INCOMING_IMAGE=whatsapp.incoming.media.image
NATS_SUBJECT_INCOMING_VIDEO=whatsapp.incoming.media.video
NATS_SUBJECT_INCOMING_AUDIO=whatsapp.incoming.media.audio
NATS_SUBJECT_INCOMING_DOCUMENT=whatsapp.incoming.media.document
NATS_SUBJECT_OUTGOING=whatsapp.outgoing
